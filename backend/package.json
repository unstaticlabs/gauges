{
  "name": "gauges-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore security rules for Gauges, and tests that run against the local emulator.",
  "scripts": {
    "test": "sh scripts/with-emulator.sh 'jest --runInBand'",
    "test:rules": "sh scripts/with-emulator.sh 'jest --runInBand test/rules'",
    "emulators": "sh scripts/with-emulator.sh",
    "typecheck": "tsc --noEmit -p ."
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    },
    "testTimeout": 30000
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "firebase": "^13.3.0",
    "firebase-tools": "^15.36.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
