# (.env.example and the *.example files). See README.md.
.env
.env*.local
/google-services.json
/GoogleService-Info.plist
/.firebaserc
# The Hosting config that scripts/deploy-web.mjs writes from firebase.json
/firebase.deploy.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Android upload key (see keystore.properties.example)
keystore.properties

# Release build output
/build/

# The local cache of the Firebase CLI after a Hosting deploy
.firebase/
