# The upload key of the Android app, for scripts/build-android.sh.
# Copy this file to mobile/keystore.properties and fill it in. Git ignores
# keystore.properties. Never commit it, and never commit the .jks file.
# Keep the .jks file outside the repository.
#
# An absolute path stays as it is. A relative path starts in mobile/.

storeFile=../../keys/gauges-upload.jks
storePassword=
keyAlias=upload
keyPassword=
