# The settings of your deployment of Gauges.
#
# Copy this file to .env.local and fill in the values of your own Firebase
# project. Git ignores .env.local. Expo reads it at build time and puts each
# EXPO_PUBLIC_ value into the app bundle, so put no secret here.
#
# Without .env.local, the app runs in demo mode: it uses the demo project
# `demo-gauges` and the local emulators (see backend/README.md). A release
# build or a web deploy refuses to run in demo mode.

# The config of the Firebase web app. Find it in the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The OAuth client of type "Web application" (client_type 3 in
# google-services.json). Google Sign-In on the phone needs it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# The website that serves the web app, the legal pages, and the invite
# links, with no slash at the end.
EXPO_PUBLIC_WEBSITE_URL=https://gauges.example.com

# Optional: the host of the local emulators, for example 127.0.0.1. Use it
# to test with your own config against the emulators. Never set it for a
# release build.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Only for scripts/build-ios.sh: your Apple Developer team ID. The app does
# not read it.
APPLE_TEAM_ID=
