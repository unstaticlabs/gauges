# Files that Git ignores in the whole repository.
# mobile/ and backend/ have their own .gitignore.

# Editors and operating systems
*~
*.sw[mnpcod]
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
$RECYCLE.BIN/
/.idea
/.vscode

# Logs and temporary files
*.log
npm-debug.log*
.tmp
*.tmp
*.tmp.*

# Dependencies
node_modules/

# The build output of the first version (tag old-ionic-app)
/www

# Signing keys, credentials, and deploy settings must never be committed
*.jks
*.keystore
keystore.properties
.env
.env*.local
service-account*.json

# Firebase emulator data and logs
firebase-debug.log*
firestore-debug.log*
.firebase/
